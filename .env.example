# Copie para .env e preencha. O arquivo .env nunca deve ser versionado.

# --- Servidor ---
RETEN_SERVER_PORT=8090
RETEN_LOG_LEVEL=INFO

# --- PostgreSQL (docker-compose usa os mesmos valores) ---
RETEN_DB_HOST=localhost
RETEN_DB_PORT=5434
RETEN_DB_NAME=reten
RETEN_DB_USER=reten
RETEN_DB_PASSWORD=troque-esta-senha

# --- E-mail (Mailpit em desenvolvimento) ---
RETEN_MAIL_PORT=1026
RETEN_MAILPIT_UI_PORT=8026

# --- Integrações (configuradas nas próximas fases) ---
# OPENAI_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# GOOGLE_BOOKS_API_KEY=

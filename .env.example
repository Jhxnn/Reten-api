# Copie para .env e preencha. O arquivo .env nunca deve ser versionado.

# --- Servidor ---
RETEN_SERVER_PORT=8090
RETEN_LOG_LEVEL=INFO
# Use 127.0.0.1 (não localhost): a Spotify só aceita loopback por IP como redirect em desenvolvimento,
# e o cookie de sessão precisa estar no mesmo host do retorno do OAuth.
RETEN_FRONTEND_URL=http://127.0.0.1:5173
RETEN_COOKIE_SECURE=false

# Chave AES-256 (Base64, 32 bytes) que cifra os tokens do Spotify no banco.
# Gere com: openssl rand -base64 32   — trocar a chave invalida as conexões Spotify existentes.
RETEN_TOKEN_ENCRYPTION_KEY=

# --- PostgreSQL (docker-compose usa os mesmos valores) ---
RETEN_DB_HOST=localhost
RETEN_DB_PORT=5434
RETEN_DB_NAME=reten
RETEN_DB_USER=reten
RETEN_DB_PASSWORD=troque-esta-senha

# --- E-mail (Mailpit em desenvolvimento: interface em http://localhost:8026) ---
RETEN_MAIL_HOST=localhost
RETEN_MAIL_PORT=1026
RETEN_MAILPIT_UI_PORT=8026
RETEN_MAIL_FROM=Resten <nao-responda@reten.local>
# Para enviar de verdade, aponte para um provedor SMTP e ative autenticação/TLS. Exemplo com Gmail
# (senha de app de 16 letras: Conta Google > Segurança > Verificação em duas etapas > Senhas de app):
# RETEN_MAIL_HOST=smtp.gmail.com
# RETEN_MAIL_PORT=587
# RETEN_MAIL_USERNAME=seu-endereco@gmail.com
# RETEN_MAIL_PASSWORD=senha-de-app-sem-espacos
# RETEN_MAIL_SMTP_AUTH=true
# RETEN_MAIL_STARTTLS=true
# RETEN_MAIL_FROM="Resten <seu-endereco@gmail.com>"
# Confirmação de e-mail por código no cadastro (padrão: ligada).
# RETEN_EMAIL_VERIFICATION_REQUIRED=true

# --- Spotify (https://developer.spotify.com/dashboard) ---
# Cadastre exatamente esta Redirect URI no app da Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/spotify/callback

# --- Livros ---
# Opcional. Sem chave, a busca usa o Open Library (sem credenciais). Com chave, usa o Google Books,
# que tem sinopses melhores em português. A cota anônima do Google Books está zerada, por isso a chave.
# Crie em https://console.cloud.google.com/apis/credentials (ative a "Books API").
GOOGLE_BOOKS_API_KEY=

# --- Inteligência artificial (OpenAI) ---
# Sem chave, a geração de playlists responde "ai_not_configured".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Vazio para modelos sem raciocínio; low/medium/high para modelos de raciocínio.
OPENAI_REASONING_EFFORT=low
# Gerações por usuário em 24 horas.
RETEN_GENERATION_DAILY_LIMIT=10
RETEN_MAX_PLAYLISTS=5

